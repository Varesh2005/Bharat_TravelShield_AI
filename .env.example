# ==============================================================================
# BHARAT-TRAVELSHIELD AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. FIREBASE CONFIGURATION
# ------------------------------------------------------------------------------
# Path to your Google Firebase Service Account JSON key.
# If omitted or file not found, system runs automatically in In-Memory Firestore mode.
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
FIREBASE_PROJECT_ID=bharat-travelshield-ai
FIREBASE_STORAGE_BUCKET=bharat-travelshield-ai.appspot.com

# ------------------------------------------------------------------------------
# 3. MACHINE LEARNING & ANN CONFIGURATION
# ------------------------------------------------------------------------------
MODEL_WEIGHTS_DIR=ml/models/weights
MODEL_NAME=MultiHazardRiskANN
MODEL_VERSION=1.0.0
USE_GPU=False

# ------------------------------------------------------------------------------
# 4. OPTIONAL POSTGRESQL CONFIGURATION (HYBRID/FALLBACK)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://bharat_app:bharat_secure_pass@localhost:5432/bharat_travelshield
