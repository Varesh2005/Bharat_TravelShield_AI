    "/api/v1/destinations/district/{district_code}/summary": {
      "get": {
        "tags": [
          "Destinations"
        ],
        "summary": "Get destination historical data summary",
        "description": "Combines historical weather, heatwave thresholds, malaria surveillance, dengue context, and flood records for a destination district.",
        "operationId": "get_destination_summary_api_v1_destinations_district__district_code__summary_get",
        "parameters": [
          {
            "name": "district_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "District Code"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional start date (YYYY-MM-DD)",
              "title": "Start Date"
            },
            "description": "Optional start date (YYYY-MM-DD)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional end date (YYYY-MM-DD)",
              "title": "End Date"
            },
            "description": "Optional end date (YYYY-MM-DD)"
          },
          {
            "name": "include_ann",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Whether to include experimental hazard ANN outputs",
              "default": false,
              "title": "Include Ann"
            },
            "description": "Whether to include experimental hazard ANN outputs"
          },
          {
            "name": "ann_feature_year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional feature year for ANN inference",
              "title": "Ann Feature Year"
            },
            "description": "Optional feature year for ANN inference"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hazards": {
      "get": {
        "tags": [
          "ML Predictions"
        ],
        "summary": "List supported hazard models",
