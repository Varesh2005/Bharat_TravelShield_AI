    "/api/v1/predict/district": {
      "post": {
        "tags": [
          "ML Predictions"
        ],
        "summary": "Predict single hazard for a district",
        "description": "Runs ANN inference for a specific hazard and district code (Census 2011).",
        "operationId": "predict_hazard_for_district_api_v1_predict_district_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DistrictPredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HazardPredictionCard"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predict/custom": {
      "post": {
        "tags": [
          "ML Predictions"
        ],
        "summary": "Predict hazard from custom feature record",
        "description": "Invokes ANN model with caller-supplied numerical features adhering to the hazard feature dictionary.",
        "operationId": "predict_hazard_custom_api_v1_predict_custom_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
