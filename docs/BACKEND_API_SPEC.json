              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predict/multi-hazard": {
      "post": {
        "tags": [
          "ML Predictions"
        ],
        "summary": "Unified multi-hazard risk assessment",
        "description": "Evaluates all supported hazards (Heatwave, Flood, Malaria, plus Dengue status) and persists an audit record in Firestore.",
        "operationId": "predict_multi_hazard_api_v1_predict_multi_hazard_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnifiedMultiHazardRequest"
              }
            }
          },
          "required": true
