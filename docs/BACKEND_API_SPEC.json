{
  "openapi": "3.1.0",
  "info": {
    "title": "Bharat-TravelShield AI \u2014 Spatiotemporal Risk Intelligence API",
    "description": "India-First Spatiotemporal Travel Health & Natural Disaster Risk Intelligence Platform. Powered by deep Artificial Neural Networks (MLP), Firebase Firestore, and official Indian meteorological and epidemiological datasets (IMD, NASA POWER, NCVBDC, NDMA).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/destinations/search": {
      "get": {
        "tags": [
          "Destinations"
        ],
        "summary": "Search Indian destinations",
        "description": "Case-insensitive search across district names, state names, and tourist spots with alias and fuzzy fallback.",
        "operationId": "search_destinations_api_v1_destinations_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Search query string (e.g. 'Jaipur', 'Goa', 'Bengaluru')",
              "title": "Q"
            },
            "description": "Search query string (e.g. 'Jaipur', 'Goa', 'Bengaluru')"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Maximum number of results to return",
              "default": 10,
              "title": "Limit"
            },
            "description": "Maximum number of results to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationSearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
