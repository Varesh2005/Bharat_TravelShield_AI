        "operationId": "list_destinations_api_v1_destinations_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 640,
              "minimum": 1,
              "description": "Maximum number of districts to list",
              "default": 50,
              "title": "Limit"
            },
            "description": "Maximum number of districts to list"
