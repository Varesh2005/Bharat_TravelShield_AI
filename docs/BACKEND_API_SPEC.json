  "components": {
    "schemas": {
      "CustomPredictionRequest": {
        "properties": {
          "hazard": {
            "type": "string",
            "title": "Hazard",
            "description": "Hazard type: 'heatwave', 'flood', or 'malaria'",
            "example": "heatwave"
          },
          "features": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Features",
            "description": "13 or 14 strict numerical features matching the model contract"
          },
          "explain": {
            "type": "boolean",
            "title": "Explain",
            "description": "Whether to include factor explanation",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "hazard",
          "features"
        ],
        "title": "CustomPredictionRequest"
      },
      "DistrictPredictionRequest": {
        "properties": {
          "hazard": {
            "type": "string",
            "title": "Hazard",
            "description": "Hazard type: 'heatwave', 'flood', or 'malaria'",
            "example": "malaria"
          },
          "district_code": {
            "type": "integer",
            "title": "District Code",
            "description": "Census 2011 district code",
            "example": 146
          },
          "feature_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feature Year",
            "description": "Feature year T (predicts T+1). None = latest complete year",
            "example": 2022
          },
          "explain": {
            "type": "boolean",
            "title": "Explain",
            "description": "Whether to include factor explanation weights",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "hazard",
          "district_code"
        ],
        "title": "DistrictPredictionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HazardPredictionCard": {
        "properties": {
          "hazard": {
            "type": "string",
            "title": "Hazard"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "based_on_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Based On Year"
          },
          "predicts_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicts Year"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability"
          },
          "predicted_class": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Class"
          },
          "predicted_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Label"
          },
          "raw_score_for_ranking_only": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Score For Ranking Only"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "risk_band": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Band"
          },
          "reliability": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reliability"
          },
          "limitations": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limitations"
          },
          "top_factors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top Factors"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "recovery_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recovery Path"
          }
        },
        "type": "object",
        "required": [
          "hazard",
          "status"
        ],
        "title": "HazardPredictionCard"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "example": "healthy"
          },
